# --- build artefacts ------------------------------------------------------
# Zips are regenerated with: python3 build.py --zip
*.zip
__pycache__/
*.pyc
.venv/

# --- node ------------------------------------------------------------------
# This site has no Node toolchain: build.py (Python 3 + Pillow) generates it and
# the only client JS is a hand-written 4.5 KB main.js. node_modules must never
# be committed — an accidental `npm i` here adds ~11 MB of vendored packages.
node_modules/

# --- OS / editor ----------------------------------------------------------
.DS_Store
.claude/

# --- working reference, not website material ------------------------------
# ~101 MB of PDFs and screenshots of the OLD IONOS site. Kept locally only.
screenshots for claude/

# NOTE: dist/ is intentionally NOT ignored. netlify.toml publishes it directly,
# so Netlify needs no build step and no Python/Pillow on its build image.
